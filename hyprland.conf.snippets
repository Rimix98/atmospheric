# ============================================================
# Weather overlay (atmospheric) — snippets for hyprland.conf
#
# Replace /path/to/atmospheric with the actual path to the project folder
# (after `atmospheric install` the autostart is already set up).
# ============================================================

# --- Step 5: autostart -------------------------------------
# Quick config launch from a directory (no need to put it in ~/.config):
exec-once = quickshell -p /path/to/atmospheric

# Alternative if the config lives in ~/.config/quickshell/atmospheric:
# exec-once = quickshell -c atmospheric

# --- Step 4: hotkeys via Quickshell IPC --------------------
# qs needs -p <config path>: without it the client looks for the "default"
# config in XDG directories and fails with "Could not find "default" config directory...".

# Toggle the overlay
bind = SUPER, F8, exec, qs -p /path/to/atmospheric ipc call weather toggle
# Force a weather refresh (e.g. after sleep)
bind = SUPER SHIFT, F8, exec, qs -p /path/to/atmospheric ipc call weather refresh

# Weather state is easy to check by hand in a terminal:
#   qs -p /path/to/atmospheric ipc call weather status
#   qs -p /path/to/atmospheric ipc show

# --- Step 5: screenshot without the overlay ---------------------------
# grim captures the layer into the frame, so atmospheric shot turns the
# overlay off before the capture and back on after (region + clipboard).
bind = , Print, exec, atmospheric shot --region --clipboard
# Full screen of the active monitor → clipboard / file:
# bind = CTRL, Print, exec, atmospheric shot --full --clipboard
# bind = CTRL, Print, exec, atmospheric shot --full --out ~/Pictures/shot_$(date +%H%M%S).png
# If you use the Quickshell region selector:
# bind = SUPER SHIFT, S, exec, atmospheric shot --qs-region

# --- Step 4 (bonus): autohide in games and mpv --------------
exec-once = bash /path/to/atmospheric/scripts/autohide-games.sh
