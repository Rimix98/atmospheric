#!/usr/bin/env bash
# ============================================================
# atmospheric — single command for the weather overlay.
#
# Install once (Wayland or X11):
#   bash /path/to/atmospheric/install.sh
#
# Then:
#   atmospheric                 # start (or enable if already running)
#   atmospheric rain            # test: rain
#   atmospheric snow            # test: snow
#   atmospheric auto            # back to real weather
#   atmospheric status
#   atmospheric city            pick a city (TUI)
# ============================================================
set -euo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
DIR="$(cd -- "$(dirname -- "$SELF")" && pwd)"
VERSION="$(cat "$DIR/VERSION" 2>/dev/null || echo "dev")"
BIN_DIR="$HOME/.local/bin"
BIN="$BIN_DIR/atmospheric"
TARGET="weather"
LOG="${TMPDIR:-/tmp}/atmospheric.log"

usage() {
    cat <<EOF
atmospheric $VERSION — weather overlay (Quickshell)

Commands:
  start | run        launch (default); if running — enable
  stop | restart     stop / restart
  status             session, weather, test mode, running state
  toggle | on | off  show / hide the overlay
  shot [opts]        screenshot without the overlay: --region, --full,
                     --clipboard, --out FILE (atmospheric shot --help)
  city               pick a city (TUI): bundled list + search for any city
                     in the world (key /, Nominatim) or plain coordinates
  autostart [on|off] autostart for the current session (status by default)
  uninstall          remove the command from PATH and autostart (keeps the project)
  version            version

Effect tests (do not touch real data):
  rain | heavy-rain | drizzle | snow | fog | fog-dense | blizzard | sleet
  hail | thunder | rainbow | cloudy | night | clear
  auto | off-test    drop the test, back to real weather
  Example: atmospheric snow

Install (Wayland or X11):
  install                command in PATH + autostart for the current session
                         (asks for the city: Enter — pick any city in the
                         world, q — keep the current one)
  install --no-autostart only the command in PATH, no autostart
  install --system       install the command to /usr/local/bin (via sudo)

Supported:
  Wayland: Hyprland, Sway, niri, river, Wayfire, labwc, KDE Plasma
           (needs wlr-layer-shell; GNOME Wayland is NOT supported)
  X11:     i3, bspwm, Openbox, XFCE, KDE/GNOME (Xorg), any WM
           (bare WMs need picom for transparency)

Log: $LOG
EOF
}

# --- state -----------------------------------------------------
# PIDs of instances running OUR config. The ^ anchor ignores incidental
# commands that merely contain the path (e.g. qs -p ... ipc ...), and the
# " ipc " filter drops the qs client — it looks like an instance but isn't.
instance_pids() {
    local p c
    for p in $(pgrep -f "^([^ ]*/)?(quickshell|qs) -p $DIR( .*)?$" 2>/dev/null) \
             $(pgrep -f "^([^ ]*/)?(quickshell|qs) -c atmospheric( .*)?$" 2>/dev/null); do
        c="$(tr '\0' ' ' 2>/dev/null < "/proc/$p/cmdline" || true)"
        case " $c " in
            *" ipc "*) continue ;;
        esac
        printf '%s\n' "$p"
    done
}

is_running() {
    [[ -n "$(instance_pids)" ]]
}

# The radar daemon (Radar.qml) is a separate process. Normally quickshell
# kills it with its Process destructor, but in a hot-reload race (a new
# daemon is spawned before the old one dies) the "winner" reparents to
# ppid=1 and outlives the shell — then it must be reaped manually.
stop_radar_daemons() {
    local pids
    pids="$(pgrep -f "$DIR/radar-backend/target/release/atmospheric-radar" 2>/dev/null || true)"
    [[ -n "$pids" ]] && kill $pids 2>/dev/null || true
}

# Stops the shell and waits for it to exit cleanly (its Process destructor
# kills its daemon), then reaps orphan daemons. Returns 1 if none was running.
stop_instance() {
    local pids i
    pids="$(instance_pids)"
    [[ -z "$pids" ]] && return 1
    kill $pids 2>/dev/null || true
    for i in $(seq 1 20); do
        is_running || break
        sleep 0.1
    done
    stop_radar_daemons
    # Race insurance: while the shell was exiting, its watchdog may have
    # restarted the daemon — reap those orphans too (idempotent).
    sleep 0.3
    stop_radar_daemons
    return 0
}

need_qs() {
    if ! command -v quickshell >/dev/null 2>&1; then
        echo "✗ quickshell not found in PATH" >&2
        exit 1
    fi
    if ! command -v qs >/dev/null 2>&1; then
        echo "✗ qs (quickshell IPC client) not found in PATH" >&2
        exit 1
    fi
}

# Start in the background; $1 — optional test mode.
start_bg() {
    need_qs
    local mode="${1:-}"
    if [[ -n "$mode" ]]; then
        export ATMOSPHERIC_TEST="$mode"
    fi
    # setsid — a separate session: the overlay won't die with the process
    # group of the terminal/script that started it (nohup only survives SIGHUP).
    local -a runner=(nohup)
    command -v setsid >/dev/null 2>&1 && runner=(setsid nohup)
    "${runner[@]}" quickshell -p "$DIR" >"$LOG" 2>&1 </dev/null &
    sleep 1.2
    if is_running; then
        if [[ -n "$mode" ]]; then
            echo "✓ Started with test: $mode (drop: atmospheric auto)"
        else
            echo "✓ Started (real weather)"
        fi
        echo "  log: $LOG"
    else
        echo "✗ Failed to start, log tail:" >&2
        tail -n 25 "$LOG" >&2 || true
        exit 1
    fi
}

ipc_ok() {   # ipc_ok <args...> — prints the reply, keeps the exit code
    # -p is required: without a config path qs looks for the "default" config
    # in XDG and dies with "Could not find "default" config directory...".
    qs -p "$DIR" ipc call "$TARGET" "$@"
}

# --- screenshot without the rain --------------------------------
# The overlay is disabled BEFORE capture and re-enabled after (if it was on).
# By the time grim/maim/scrot/import or the Quickshell region selector runs,
# the window is already hidden — no rain in the file or the clipboard.
# On Hyprland we wait for the layer to actually vanish (hyprctl layers),
# otherwise we fall back to a short pause.
_shot_was_on=0
_shot_keep=0
_shot_tmp=""
_shot_lock="${TMPDIR:-/tmp}/atmospheric-shot.lockdir"
_shot_geom=""        # file where a pre-launched slurp writes geometry
_shot_slurp_pid=""   # its PID

# Shots are serialized by a directory, not flock: flock is inherited by
# child processes, and `wl-copy` (which stays alive while it owns the
# buffer) would hold the lock forever — later shots would queue for 5 min.
_shot_lock_acquire() {
    local i pid
    for ((i = 0; i < 3000; i++)); do
        if mkdir "$_shot_lock" 2>/dev/null; then
            printf '%s\n' "$$" > "$_shot_lock/pid"
            return 0
        fi
        # The owner may have died and left the directory behind — take it.
        pid="$(cat "$_shot_lock/pid" 2>/dev/null || true)"
        if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
            rm -rf -- "$_shot_lock"
            continue
        fi
        sleep 0.1
    done
    echo "atmospheric shot: another shot is in progress (waited 5 min)" >&2
    return 1
}

_shot_lock_release() {
    if [[ -d "$_shot_lock" ]] && [[ "$(cat "$_shot_lock/pid" 2>/dev/null)" == "$$" ]]; then
        rm -rf -- "$_shot_lock"
    fi
}

_shot_restore() {
    # The background selection may outlive Ctrl+C — kill it, otherwise slurp
    # would sit on screen until a manual Escape.
    if [[ -n "${_shot_slurp_pid:-}" ]]; then
        kill "$_shot_slurp_pid" 2>/dev/null || true
        _shot_slurp_pid=""
    fi
    [[ -n "${_shot_geom:-}" ]] && rm -f -- "$_shot_geom" 2>/dev/null
    _shot_geom=""
    [[ -n "${_shot_tmp:-}" ]] && rm -f -- "$_shot_tmp" 2>/dev/null
    _shot_tmp=""
    _shot_lock_release
    if [[ "$_shot_was_on" == "1" && "$_shot_keep" != "1" ]]; then
        ipc_ok enable >/dev/null 2>&1 || true
    fi
}

# Hide the overlay and wait for the frame to actually clear. Per-pixel
# measurements: 0.26 s after hiding, rain is still in the frame (1392 px
# differ); it only clears by ~0.63 s — the layer leaves hyprctl layers
# before it fades, so polling alone is not enough, a pause is needed too.
_shot_hide_overlay() {
    local delay="${1:-0.6}"
    _shot_was_on=0
    is_running || return 0
    [[ "$(ipc_ok isEnabled 2>/dev/null || true)" == "0" ]] && return 0
    _shot_was_on=1
    ipc_ok disable >/dev/null 2>&1 || true
    wait_overlay_hidden "$delay"
}

_layer_present() {  # $1 — layer namespace
    hyprctl layers 2>/dev/null | grep -q -- "$1"
}

wait_overlay_hidden() {
    local delay="${1:-0.5}" i
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        for ((i = 0; i < 60; i++)); do          # up to 3 s
            _layer_present "quickshell-weather" || break
            sleep 0.05
        done
    fi
    # hyprctl may drop the layer from the list before the fade-out animation
    # finishes — give the frame time to settle, or rain could still get in.
    sleep "$delay"
}

wait_selector_closed() {
    local i
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        for ((i = 0; i < 80; i++)); do          # wait to open (up to 4 s)
            _layer_present "quickshell:regionSelector" && break
            sleep 0.05
        done
        for ((i = 0; i < 7200; i++)); do        # wait for the pick (up to 6 min)
            _layer_present "quickshell:regionSelector" || return 0
            sleep 0.05
        done
    else
        sleep 1
    fi
}

do_shot() {
    local region=0 clipboard=0 out="" monitor="" delay="0.6" qs_cfg=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--region)    region=1 ;;
            -f|--full)      region=0 ;;
            -c|--clipboard) clipboard=1 ;;
            -o|--out)       out="${2:?--out requires a file path}"; shift ;;
            --monitor)      monitor="${2:?--monitor requires an output name}"; shift ;;
            --delay)        delay="${2:?--delay requires seconds}"; shift ;;
            --qs-region)
                # The config name may be omitted — taken from a running qs -c NAME.
                qs_cfg="auto"
                if [[ $# -gt 1 && "${2:0:1}" != "-" ]]; then qs_cfg="$2"; shift; fi ;;
            --keep-hidden)  _shot_keep=1 ;;
            --)             shift; break ;;
            -h|--help)
                cat <<'EOF'
atmospheric shot — screenshot without the weather overlay.

  --region, -r        pick a region (slurp; on X11 — maim -s)
  --full, -f          whole screen (default)
  --clipboard, -c     put the shot on the clipboard (wl-copy / xclip)
  --out FILE, -o FILE save to FILE (else ~/Pictures/Screenshot_*.png)
  --monitor NAME      capture a specific monitor (grim -o)
  --delay SEC         pause after hiding when there is no hyprctl (0.6)
  --qs-region CFG     region via the Quickshell selector (qs -c CFG)
  --keep-hidden       don't re-enable the overlay
EOF
                return 0 ;;
            -*)             echo "atmospheric shot: unknown option: $1" >&2; return 2 ;;
            *)              out="$1" ;;
        esac
        shift
    done

    # Restore in any case: error, Ctrl+C, cancelled selection.
    trap '_shot_restore' EXIT

    # One key often has two binds (region + full screen): without
    # serialization the second would re-enable the overlay in the middle of
    # the first one's selection, and rain would get into the frame again.
    _shot_lock_acquire || return 1
    _shot_was_on=0

    # Region on Wayland: slurp is launched BEFORE hiding — while the user
    # picks a region, the overlay fades out in the background. The selection
    # opens right away (~0.1 s) instead of after the hide pause (~0.8 s),
    # but the shot is still taken from an already cleared frame.
    if [[ -z "$qs_cfg" && "$region" == "1" && -n "${WAYLAND_DISPLAY:-}" ]] \
        && command -v grim >/dev/null 2>&1 && command -v slurp >/dev/null 2>&1; then
        _shot_geom="$(mktemp "${TMPDIR:-/tmp}/atmospheric-geom-XXXXXX")"
        slurp >"$_shot_geom" 2>/dev/null &
        _shot_slurp_pid=$!
    fi

    _shot_hide_overlay "$delay"

    if [[ -n "$qs_cfg" ]]; then
        if [[ "$qs_cfg" == "auto" ]]; then
            qs_cfg="$(pgrep -af '(^|/)(qs|quickshell) -c ' 2>/dev/null \
                | awk '{for (i = 1; i <= NF; i++) if ($i == "-c") { print $(i+1); exit }}')"
            if [[ -z "$qs_cfg" ]]; then
                echo "✗ No running Quickshell with a named config (-c NAME) found" >&2
                return 1
            fi
        fi
        # The Quickshell selector puts the result on the clipboard/file
        # itself; we only must not let it freeze a frame with rain and must
        # wait for it to close.
        qs -c "$qs_cfg" ipc call region screenshot >/dev/null 2>&1 || {
            echo "✗ Failed to open the region selector (qs -c $qs_cfg)" >&2
            return 1
        }
        wait_selector_closed
        return 0
    fi

    _shot_tmp="$(mktemp "${TMPDIR:-/tmp}/atmospheric-shot-XXXXXX.png")"
    local -a gargs=()
    [[ -n "$monitor" ]] && gargs+=(-o "$monitor")

    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v grim >/dev/null 2>&1; then
        if [[ "$region" == "1" ]]; then
            local geom rc=0
            if [[ -n "$_shot_geom" ]]; then
                # slurp is already running — wait for the pick (or cancel).
                wait "$_shot_slurp_pid" || rc=$?
                geom="$(cat "$_shot_geom" 2>/dev/null || true)"
                rm -f -- "$_shot_geom"; _shot_geom=""; _shot_slurp_pid=""
                if (( rc != 0 )) || [[ -z "$geom" ]]; then
                    echo "Cancelled" >&2
                    return 1
                fi
            else
                command -v slurp >/dev/null 2>&1 || {
                    echo "✗ --region needs slurp (package: slurp)" >&2
                    return 1
                }
                geom="$(slurp)" || { echo "Cancelled" >&2; return 1; }
            fi
            gargs+=(-g "$geom")
        fi
        grim "${gargs[@]}" "$_shot_tmp"
    elif command -v maim >/dev/null 2>&1; then
        if [[ "$region" == "1" ]]; then
            maim -s "$_shot_tmp"
        elif [[ -n "$monitor" ]]; then
            maim -d "$monitor" "$_shot_tmp"
        else
            maim "$_shot_tmp"
        fi
    elif command -v scrot >/dev/null 2>&1; then
        scrot "$_shot_tmp"
    elif command -v import >/dev/null 2>&1; then
        import -window root "$_shot_tmp"
    else
        echo "✗ No grim (Wayland) or maim/scrot/import (X11) found" >&2
        return 1
    fi

    if [[ "$clipboard" == "1" ]]; then
        if command -v wl-copy >/dev/null 2>&1; then
            wl-copy < "$_shot_tmp"
        elif command -v xclip >/dev/null 2>&1; then
            xclip -selection clipboard -t image/png -i "$_shot_tmp"
        else
            echo "! No wl-copy/xclip — the shot will be saved to a file" >&2
            clipboard=0
        fi
    fi

    # Save to a file when one was given explicitly or the clipboard is unavailable.
    if [[ -n "$out" || "$clipboard" == "0" ]]; then
        out="${out:-$HOME/Pictures/Screenshot_$(date +%F_%H-%M-%S).png}"
        mkdir -p -- "$(dirname -- "$out")"
        mv -f -- "$_shot_tmp" "$out"
        _shot_tmp=""
        echo "$out"
    fi
}

# --- session: Wayland/X11 and DE/WM -----------------------------
# Everything below exists to install autostart into the right place.
detect_session() {
    case "${XDG_SESSION_TYPE:-}" in
        wayland|x11) printf '%s\n' "$XDG_SESSION_TYPE"; return 0 ;;
    esac
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && { echo wayland; return 0; }
    [[ -n "${DISPLAY:-}" ]] && { echo x11; return 0; }
    echo unknown
}

detect_desktop() {
    local d
    # Most reliable identification: variables the compositor sets itself.
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && { echo hyprland; return 0; }
    [[ -n "${SWAYSOCK:-}" ]] && { echo sway; return 0; }
    [[ -n "${NIRI_SOCKET:-}" ]] && { echo niri; return 0; }
    [[ -n "${RIVER_SOCKET:-}" ]] && { echo river; return 0; }
    d="${XDG_CURRENT_DESKTOP:-}:${DESKTOP_SESSION:-}:${GDMSESSION:-}"
    d="${d,,}"
    case "$d" in
        *hyprland*)          echo hyprland ;;
        *sway*)              echo sway ;;
        *niri*)              echo niri ;;
        *river*)             echo river ;;
        *wayfire*)           echo wayfire ;;
        *labwc*)             echo labwc ;;
        *kde*|*plasma*)      echo kde ;;
        *gnome*|*ubuntu*)    echo gnome ;;
        *xfce*)              echo xfce ;;
        *cinnamon*)          echo cinnamon ;;
        *mate*)              echo mate ;;
        *lxqt*)              echo lxqt ;;
        *lxde*)              echo lxde ;;
        *budgie*)            echo budgie ;;
        *i3*)                echo i3 ;;
        *bspwm*)             echo bspwm ;;
        *openbox*)           echo openbox ;;
        *awesome*)           echo awesome ;;
        *dwm*)               echo dwm ;;
        *qtile*)             echo qtile ;;
        *xmonad*)            echo xmonad ;;
        *herbstluftwm*)      echo herbstluftwm ;;
        *)                   echo "" ;;
    esac
}

# On X11 the WM name can be asked from the X server itself (needs xprop).
detect_x11_wm() {
    command -v xprop >/dev/null 2>&1 || { echo ""; return 0; }
    local id name
    id="$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | awk '{print $NF}')"
    [[ -z "$id" || "$id" == "0x0" ]] && { echo ""; return 0; }
    name="$(xprop -id "$id" _NET_WM_NAME 2>/dev/null | sed -n 's/.*= "\(.*\)"/\1/p')"
    name="${name%% *}"          # "Hyprland :d" -> "hyprland"
    echo "${name,,}"
}

# Short human-readable session summary (for status/install).
env_summary() {
    local sess desktop
    sess="$(detect_session)"
    desktop="$(detect_desktop)"
    [[ -z "$desktop" && "$sess" == "x11" ]] && desktop="$(detect_x11_wm)"
    [[ -z "$desktop" ]] && desktop="unknown WM/DE"
    echo "$sess · $desktop"
}

# Where to install autostart. Keys:
#   hyprland|sway|niri|river|wayfire|labwc — native configs of Wayland WMs
#   i3|bspwm|openbox                        — native configs of X11 WMs
#   xdg                                     — ~/.config/autostart/*.desktop
#                                             (KDE, GNOME, XFCE, Cinnamon,
#                                              MATE, LXQt, Budgie, others)
#   gnome-wayland                           — not possible: no wlr-layer-shell
autostart_target() {
    local sess desktop
    sess="$(detect_session)"
    desktop="$(detect_desktop)"
    [[ -z "$desktop" && "$sess" == "x11" ]] && desktop="$(detect_x11_wm)"
    case "$desktop" in
        hyprland|sway|niri|river|wayfire|labwc) echo "$desktop"; return 0 ;;
        i3|bspwm|openbox)                       echo "$desktop"; return 0 ;;
        *i3*)                                   echo i3; return 0 ;;
        *bspwm*)                                echo bspwm; return 0 ;;
        *openbox*)                              echo openbox; return 0 ;;
    esac
    if [[ "$sess" == "wayland" ]]; then
        [[ "$desktop" == "gnome" ]] && { echo gnome-wayland; return 0; }
        echo xdg; return 0
    fi
    echo xdg
}

autostart_file() {
    case "$1" in
        hyprland) echo "$HOME/.config/hypr/hyprland.conf" ;;
        sway)     echo "$HOME/.config/sway/config" ;;
        niri)     echo "$HOME/.config/niri/config.kdl" ;;
        river)    echo "$HOME/.config/river/init" ;;
        wayfire)  echo "$HOME/.config/wayfire.ini" ;;
        labwc)    echo "$HOME/.config/labwc/autostart" ;;
        i3)       echo "$HOME/.config/i3/config" ;;
        bspwm)    echo "$HOME/.config/bspwm/bspwmrc" ;;
        openbox)  echo "$HOME/.config/openbox/autostart" ;;
        xdg)      echo "$HOME/.config/autostart/atmospheric.desktop" ;;
        *)        echo "" ;;
    esac
}

# The autostart command is the same on Wayland and X11: quickshell picks
# the backend by session (Wayland → layer-shell, X11 → a plain window).
autostart_cmd() { printf 'quickshell -p %s' "$DIR"; }

autostart_present() {
    local target="$1" file
    file="$(autostart_file "$target")"
    [[ -n "$file" && -f "$file" ]] || return 1
    case "$target" in
        wayfire) grep -qE "^atmospheric[[:space:]]*=[[:space:]]*quickshell -p" "$file" 2>/dev/null ;;
        niri)    grep -qE "spawn-at-startup.*quickshell.*-p.*$DIR" "$file" 2>/dev/null ;;
        # Old installs (without a marker) also count as configured:
        # the exact command with our path is enough.
        *)       grep -qF "quickshell -p $DIR" "$file" 2>/dev/null ;;
    esac
}

# Strips all our autostart lines from a config: markers and the command
# with the exact path to this directory. Foreign lines are left alone.
autostart_strip() {
    local file="$1" tmp esc
    tmp="$(mktemp)"
    esc="$(printf '%s' "$DIR" | sed 's/[][\\.*^$+?(){}|]/\\&/g')"
    grep -vE "atmospheric-autostart|^[[:space:]]*# --- atmospheric:|quickshell.*-p[[:space:]]+\"?${esc}\"?" \
        "$file" > "$tmp" || true
    cat "$tmp" > "$file"   # keep the inode
    rm -f "$tmp"
}

do_autostart() {
    local action="${1:-status}"
    local sess target file cmd line marker bak
    sess="$(detect_session)"
    target="$(autostart_target)"
    file="$(autostart_file "$target")"
    cmd="$(autostart_cmd)"

    if [[ "$sess" == "unknown" && "$action" != "status" ]]; then
        echo "! No graphical session detected (no WAYLAND_DISPLAY/DISPLAY)" >&2
        echo "  Autostart not configured. Run from a graphical session or add manually:" >&2
        echo "    $cmd" >&2
        return 1
    fi

    if [[ "$target" == "gnome-wayland" && "$action" == "off" ]]; then
        echo "Autostart not configured (GNOME Wayland is not supported)"
        return 0
    fi

    if [[ "$target" == "gnome-wayland" && "$action" != "status" ]]; then
        echo "✗ GNOME Wayland is not supported: Mutter has no wlr-layer-shell," >&2
        echo "  so the overlay cannot layer over windows. Options:" >&2
        echo "  • GNOME session on X11 (Xorg) — the X11 backend works there;" >&2
        echo "  • another Wayland compositor: Hyprland, Sway, niri, river, KDE Plasma." >&2
        echo "  You can still start the overlay manually: $cmd" >&2
        return 1
    fi

    case "$action" in
        status)
            echo "Session:    $(env_summary)"
            if [[ "$target" == "gnome-wayland" ]]; then
                echo "Autostart: impossible — GNOME Wayland (no wlr-layer-shell)"
                echo "State:     ✗ the overlay cannot layer over windows"
                return 0
            fi
            if [[ "$target" == "xdg" ]]; then
                echo "Autostart: XDG autostart ($file)"
                case "$(detect_desktop)" in
                    kde|gnome|xfce|cinnamon|mate|lxqt|lxde|budgie) ;;
                    *) if [[ "$sess" == "x11" ]]; then
                           echo "  (if your WM doesn't read ~/.config/autostart — add manually:"
                           echo "   $cmd)"
                       fi ;;
                esac
            else
                echo "Autostart: $target ($file)"
            fi
            if autostart_present "$target"; then
                echo "State:     ✓ configured"
            else
                echo "State:     ✗ not configured (atmospheric autostart on)"
            fi
            return 0
            ;;

        off)
            if ! autostart_present "$target"; then
                echo "Autostart not configured — nothing to remove"
                return 0
            fi
            if [[ "$target" == "xdg" ]]; then
                rm -f "$file"
                echo "✓ Autostart removed: $file"
                return 0
            fi
            if [[ -f "$file" ]]; then
                bak="$file.bak-atmospheric-$(date +%Y%m%d-%H%M%S-%N)"
                cp -a "$file" "$bak"
                autostart_strip "$file"
                echo "✓ Autostart removed (backup: $(basename "$bak"))"
            fi
            return 0
            ;;

        on)
            if autostart_present "$target"; then
                echo "✓ Autostart already configured: $file"
                return 0
            fi
            mkdir -p "$(dirname "$file")"

            if [[ "$target" == "xdg" ]]; then
                cat > "$file" <<EOF
[Desktop Entry]
Type=Application
Name=Atmospheric weather overlay
Comment=Quickshell weather overlay (atmospheric)
Exec=$cmd
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
                echo "✓ Autostart: $file"
                return 0
            fi

            # Backup before editing a user config.
            if [[ -f "$file" ]]; then
                bak="$file.bak-atmospheric-$(date +%Y%m%d-%H%M%S-%N)"
                cp -a "$file" "$bak"
            fi

            case "$target" in
                niri)
                    marker="// atmospheric-autostart: weather overlay"
                    line="spawn-at-startup \"quickshell\" \"-p\" \"$DIR\""
                    printf '\n%s\n%s\n' "$marker" "$line" >> "$file" ;;
                wayfire)
                    # INI: the key must live in the [autostart] section.
                    if grep -qE '^\[autostart\]' "$file" 2>/dev/null; then
                        local tmp; tmp="$(mktemp)"
                        awk -v key="atmospheric = $cmd" '
                            { print }
                            /^\[autostart\]/ && !done {
                                print "# atmospheric-autostart"
                                print key
                                done = 1
                            }
                        ' "$file" > "$tmp"
                        cat "$tmp" > "$file"; rm -f "$tmp"
                    else
                        printf '\n[autostart]\n# atmospheric-autostart\natmospheric = %s\n' "$cmd" >> "$file"
                    fi ;;
                river|labwc|bspwm|openbox)
                    [[ -f "$file" ]] || printf '#!/bin/sh\n' > "$file"
                    printf '\n# atmospheric-autostart: weather overlay\n%s &\n' "$cmd" >> "$file"
                    chmod +x "$file" ;;
                hyprland)
                    printf '\n# atmospheric-autostart: weather overlay\nexec-once = %s\n' "$cmd" >> "$file" ;;
                sway)
                    printf '\n# atmospheric-autostart: weather overlay\nexec %s\n' "$cmd" >> "$file" ;;
                i3)
                    printf '\n# atmospheric-autostart: weather overlay\nexec --no-startup-id %s\n' "$cmd" >> "$file" ;;
            esac

            if [[ -n "${bak:-}" ]]; then
                echo "✓ Autostart: $file (backup: $(basename "$bak"))"
            else
                echo "✓ Autostart: $file"
            fi
            return 0
            ;;

        *)
            echo "autostart: unknown action '$action' (on|off|status)" >&2
            return 2 ;;
    esac
}

# Package manager hint: dep_hint <pacman> <apt> <dnf>.
dep_hint() {
    if command -v pacman >/dev/null 2>&1; then printf 'pacman -S %s' "$1"
    elif command -v apt-get >/dev/null 2>&1; then printf 'sudo apt install %s' "$2"
    elif command -v dnf >/dev/null 2>&1; then printf 'sudo dnf install %s' "$3"
    elif command -v zypper >/dev/null 2>&1; then printf 'sudo zypper install %s' "$2"
    else printf '%s' "$1"; fi
}

# Puts a symlink into PATH; for /usr/local/bin uses sudo when needed.
link_bin() {
    local src="$1" dst="$2"
    ln -sfn "$src" "$dst" 2>/dev/null && return 0
    if command -v sudo >/dev/null 2>&1; then
        mkdir -p "$(dirname -- "$dst")" 2>/dev/null || sudo mkdir -p "$(dirname -- "$dst")"
        sudo ln -sfn "$src" "$dst" 2>/dev/null && return 0
    fi
    return 1
}

do_install() {
    local use_system="no" want_autostart="yes"
    local a
    for a in "$@"; do
        case "$a" in
            --system)                  use_system="yes" ;;
            --no-autostart|--no-hyprland) want_autostart="no" ;;
            --autostart|--hyprland)    want_autostart="yes" ;;  # legacy aliases
            -h|--help)                 usage; return 0 ;;
            *) echo "install: unknown argument: $a" >&2; exit 2 ;;
        esac
    done

    # --- where to put the command --------------------------------
    # Priority: ATMOSPHERIC_BIN_DIR → --system → ~/.local/bin (if in PATH)
    # → /usr/local/bin (if writable) → ~/.local/bin with a hint.
    if [[ -n "${ATMOSPHERIC_BIN_DIR:-}" ]]; then
        BIN_DIR="$ATMOSPHERIC_BIN_DIR"
    elif [[ "$use_system" == "yes" ]]; then
        BIN_DIR="/usr/local/bin"
    else
        case ":$PATH:" in
            *":$HOME/.local/bin:"*) BIN_DIR="$HOME/.local/bin" ;;
            *) if [[ -d /usr/local/bin && -w /usr/local/bin ]]; then
                   BIN_DIR="/usr/local/bin"
               else
                   BIN_DIR="$HOME/.local/bin"
               fi ;;
        esac
    fi
    BIN="$BIN_DIR/atmospheric"

    chmod +x "$SELF" 2>/dev/null || true
    if ! link_bin "$SELF" "$BIN"; then
        echo "✗ Could not write $BIN" >&2
        if [[ "$BIN_DIR" != "$HOME/.local/bin" ]]; then
            BIN_DIR="$HOME/.local/bin"
            BIN="$BIN_DIR/atmospheric"
            mkdir -p "$BIN_DIR"
            ln -sfn "$SELF" "$BIN"
            echo "→ Installed into the user directory: $BIN"
        else
            return 1
        fi
    fi
    echo "✓ Command: $BIN -> $SELF"

    # --- dependencies -------------------------------------------
    if command -v quickshell >/dev/null 2>&1; then
        echo "✓ quickshell found"
    else
        echo "✗ quickshell NOT found — install it:"
        echo "    Arch:   yay -S quickshell-git   (or pacman -S quickshell)"
        echo "    other:  $(dep_hint quickshell quickshell quickshell)  (see quickshell.outfoxxed.me)"
    fi
    command -v qs >/dev/null 2>&1 \
        && echo "✓ qs found" \
        || echo "✗ qs NOT found (it ships with the quickshell package)"

    if command -v socat >/dev/null 2>&1; then :; else
        echo "! socat not found — auto-hide in games (Hyprland) won't work"
    fi

    # Screenshots: grim is Wayland-only; on X11 — maim/scrot/import.
    local shot=""
    for t in grim maim scrot import; do
        command -v "$t" >/dev/null 2>&1 && { shot="$t"; break; }
    done
    if [[ -z "$shot" ]]; then
        echo "! no screenshot tool found — scripts/screenshot.sh won't work"
        echo "    Wayland: grim · X11: maim/scrot/imagemagick"
    fi

    # X11 without a compositor: the window would be opaque (black background).
    if [[ "$(detect_session)" == "x11" ]]; then
        case "$(detect_desktop)" in
            gnome|kde|xfce|cinnamon|mate|lxqt|lxde|budgie) ;;
            *) echo "! X11 without a DE compositor — run picom (or compton) for transparency" ;;
        esac
    fi

    # RainViewer radar: a Rust daemon (network + PNG decode run outside
    # QML/Canvas). cargo skips already-built output — repeat installs are fast.
    if command -v cargo >/dev/null 2>&1; then
        local buildlog
        if buildlog=$(cd "$DIR/radar-backend" && cargo build --release 2>&1); then
            echo "✓ radar daemon built (radar-backend/target/release/atmospheric-radar)"
        else
            echo "! radar build failed — the radar will be radar=none, output:" >&2
            echo "$buildlog" | tail -15 >&2
        fi
    else
        echo "! cargo not found — radar daemon not built (pacman -S rust); forecast and effects work"
    fi

    # A fastfetch wrapper with weather ASCII art used to be installed here.
    # The feature is gone — remove any leftover symlink in PATH.
    local legacy
    for legacy in "$HOME/.local/bin/fastfetch" "/usr/local/bin/fastfetch"; do
        if [[ -L "$legacy" ]] && [[ "$(readlink -f -- "$legacy" 2>/dev/null)" == "$DIR/scripts/fastfetch-weather" ]]; then
            rm -f "$legacy" 2>/dev/null || sudo rm -f "$legacy" 2>/dev/null || true
            echo "✓ Removed a legacy fastfetch symlink: $legacy"
        fi
    done

    # City choice at install time. First run (city empty) — straight into
    # the TUI; later — a quick question: Enter opens the picker (search any
    # city in the world with /, coordinates work too).
    if [[ -f "$DIR/Config.qml" ]]; then
        local cur_city="" ans=""
        cur_city="$(grep -oE 'property string city: "[^"]*"' "$DIR/Config.qml" | head -n1 | sed 's/.*"\(.*\)"/\1/' || true)"
        if [[ -z "$cur_city" ]]; then
            echo
            echo "No city chosen yet — pick one (/ in the menu — any city in the world):"
            do_city || echo "! City choice skipped (later: atmospheric city)"
        elif [[ -t 0 && -t 1 ]]; then
            echo
            printf 'City: %s — Enter to pick another (any city in the world), q to keep: ' "$cur_city"
            IFS= read -r ans || ans="q"
            case "$ans" in
                ""|y|Y) do_city || true ;;
                *) echo "Keeping: $cur_city" ;;
            esac
        fi
    fi

    case ":${PATH:-}:" in
        *":${BIN_DIR}:"*) echo "✓ $BIN_DIR is already in PATH" ;;
        *) echo "! Add to PATH:  export PATH=\"${BIN_DIR}:\$PATH\"  (in ~/.bashrc, ~/.zshrc or ~/.config/fish/config.fish)" ;;
    esac

    # --- autostart for the current session ----------------------
    echo
    if [[ "$want_autostart" == "yes" ]]; then
        do_autostart on || true   # an unsupported session must not break install
    else
        echo "Autostart skipped (--no-autostart)"
    fi

    cat <<EOF

Done. Try:
  atmospheric            # start the overlay
  atmospheric rain       # test rain
  atmospheric status     # session, weather, test mode
  atmospheric city       # change the city (TUI)
  atmospheric autostart  # where autostart is configured

Toggle hotkey (optional):
  Hyprland:  bind = SUPER, F8, exec, qs -p $DIR ipc call weather toggle
  Sway/i3:   bindsym \$mod+F8 exec qs -p $DIR ipc call weather toggle
  others:    bind this command in your desktop settings:
             qs -p $DIR ipc call weather toggle

Screenshot without the overlay: bash $DIR/scripts/screenshot.sh
EOF
}

# --- uninstall --------------------------------------------------
# Removes only system integration: autostart and PATH symlinks.
# Keeps the project directory and Config.qml (the city) intact.
do_uninstall() {
    local bin target

    stop_instance || true
    echo
    do_autostart off || true
    echo

    for bin in "$(command -v atmospheric 2>/dev/null || true)" \
               "$HOME/.local/bin/fastfetch" "/usr/local/bin/fastfetch"; do
        [[ -n "$bin" && -L "$bin" ]] || continue
        target="$(readlink -f -- "$bin" 2>/dev/null || true)"
        # $DIR/scripts/fastfetch-weather — a leftover of the old ASCII-art version.
        if [[ "$target" == "$SELF" || "$target" == "$DIR/scripts/fastfetch-weather" ]]; then
            if rm -f "$bin" 2>/dev/null || sudo rm -f "$bin" 2>/dev/null; then
                echo "✓ Removed: $bin"
            else
                echo "! Could not remove $bin (no permission)" >&2
            fi
        fi
    done

    echo
    echo "The project stays where it is: $DIR"
    echo "Settings (city etc.) live in Config.qml; log — $LOG"
}

# --- search for any city in the world ---------------------------
# Nominatim (OpenStreetMap) → "Name|latitude|longitude" lines — the same
# format as assets/cities.txt — results feed the same picker menu.
# Coordinates ("55.75,37.61") are accepted too — no network needed then.
city_geocode() {
    local q="${1:-}" json out="" attempt
    q="$(printf '%s' "$q" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -n "$q" ]] || return 1

    # direct coordinates instead of a name (separated by , or space or ;)
    local re='^-?[0-9]+([.][0-9]+)?[ ,;]+-?[0-9]+([.][0-9]+)?$'
    if [[ "$q" =~ $re ]]; then
        local la="${q%%[ ,;]*}" lo="${q##*[ ,;]}"
        # %s, not %.4f: printf breaks dot-decimal numbers in comma locales
        printf '%s|%s|%s\n' "Coordinates $la,$lo" "$la" "$lo"
        return 0
    fi

    command -v curl >/dev/null 2>&1 || {
        echo "! curl not found — city search unavailable, keeping the file list" >&2
        return 1
    }

    # Nominatim asks for ≤1 request per second and a meaningful User-Agent.
    # One retry in case of a network hiccup.
    for attempt in 1 2; do
        if json="$(curl -fsS --max-time 8 -G 'https://nominatim.openstreetmap.org/search' \
                --data-urlencode "q=$q" --data-urlencode 'format=jsonv2' \
                --data-urlencode 'limit=8' --data-urlencode 'addressdetails=1' \
                -H "User-Agent: atmospheric-installer/$VERSION" \
                -H 'Accept-Language: en' 2>/dev/null)"; then
            break
        fi
        json=""
        (( attempt == 2 )) && sleep 1
    done
    if [[ -z "$json" ]]; then
        echo "! City search failed (no network or Nominatim rate limit) — keeping the file list" >&2
        return 1
    fi

    # JSON parsing: python3, else jq. Populated places rank above provinces.
    if command -v python3 >/dev/null 2>&1; then
        out="$(printf '%s' "$json" | python3 -c '
import json, sys
rank = {"city": 0, "town": 1, "village": 2, "municipality": 3, "suburb": 4,
        "neighbourhood": 5, "county": 6, "province": 7, "state": 8, "country": 9}
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
rows = []
for r in data[:8]:
    name = (r.get("name") or "").strip().replace("|", "/")
    if not name:
        continue
    try:
        lat, lon = float(r["lat"]), float(r["lon"])
    except Exception:
        continue
    country = ((r.get("address") or {}).get("country") or "").strip().replace("|", "/")
    label = name + (", " + country if country else "")
    rows.append((rank.get(r.get("addresstype") or r.get("type") or "", 6), label, lat, lon))
for _, label, lat, lon in sorted(rows):
    print("%s|%.4f|%.4f" % (label, lat, lon))
')" || out=""
    elif command -v jq >/dev/null 2>&1; then
        out="$(printf '%s' "$json" | jq -r '
            def r: (.addresstype // .type // "") as $k |
                {"city":0,"town":1,"village":2,"municipality":3,"suburb":4,
                 "neighbourhood":5,"county":6,"province":7,"state":8,
                 "country":9}[$k] // 6;
            [.[:8][] | select((.name // "") != "")
                | {n: .name, c: (.address.country // ""),
                   k: r, la: .lat, lo: .lon,
                   l: (.name + (if (.address.country // "") == "" then ""
                                else ", " + .address.country end))}]
            | sort_by(.k)[] | "\(.l)|\(.la)|\(.lo)"
        ' 2>/dev/null)" || out=""
    else
        echo "! City search needs python3 or jq" >&2
        return 1
    fi

    [[ -n "$out" ]] || return 1
    printf '%s\n' "$out"
}

# --- city picker (TUI) ------------------------------------------
# List: assets/cities.txt, format "Name|latitude|longitude".
# The pick is written into Config.qml (city/latitude/longitude) in place,
# same inode — quickshell picks the save up itself (hot-reload) and
# immediately refetches weather for the new city.
do_city() {
    local file="$DIR/assets/cities.txt"
    local cfg="$DIR/Config.qml"
    [[ -f $file ]] || { echo "No city list file: $file" >&2; return 1; }
    [[ -f $cfg ]]  || { echo "No Config.qml: $cfg" >&2; return 1; }

    local -a cities
    mapfile -t cities < <(grep -vE '^[[:space:]]*(#|$)' "$file" | LC_ALL=C sort)
    local n=${#cities[@]}
    (( n > 0 )) || { echo "City list is empty" >&2; return 1; }

    # the cursor starts on the current city from Config (default: New York)
    local cur sel=0 i
    cur="$(grep -oE 'property string city: "[^"]*"' "$cfg" | head -n1 | sed 's/.*"\(.*\)"/\1/' || true)"
    [[ -z $cur ]] && cur="New York"
    for ((i = 1; i <= n; i++)); do
        if [[ "${cities[i-1]%%|*}" == "$cur" ]]; then sel=$i; break; fi
    done
    (( sel == 0 )) && sel=1

    local pick="" name rest lat lon notice=""
    if [[ -t 0 && -t 1 ]]; then
        # --- interactive menu: arrows/W vim, Enter, / search, q ---
        local view=18 start key k2 num
        printf '\033[?25l'
        while true; do
            start=$(( sel - view / 2 ))
            (( start < 1 )) && start=1
            (( start > n - view + 1 )) && start=$(( n - view + 1 ))
            (( start < 1 )) && start=1

            printf '\033[H\033[2J'
            printf '  Pick a city  (%d/%d)\n' "$sel" "$n"
            [[ -n "$notice" ]] && printf '  \033[33m%s\033[0m\n' "$notice"
            printf '  \033[2marrows or W vim · Enter — pick · / — any city · q — back\033[0m\n'
            (( start > 1 )) && printf '  \033[2m… above …\033[0m\n'
            for ((i = start; i < start + view && i <= n; i++)); do
                name="${cities[i-1]%%|*}"
                if (( i == sel )); then
                    printf '  \033[7m▶ %2d. %s\033[0m\n' "$i" "$name"
                else
                    printf '    %2d. %s\n' "$i" "$name"
                fi
            done
            (( start + view <= n )) && printf '  \033[2m… below …\033[0m\n'

            key=""
            IFS= read -rsn1 key || key="q"
            if [[ $key == $'\e' ]]; then
                k2=""
                IFS= read -rsn2 -t 0.05 k2 || k2=""
                key="$key$k2"
            fi
            case "$key" in
                $'\e[A'|$'\eOA'|k|K) if (( sel > 1 )); then sel=$(( sel - 1 )); fi ;;
                $'\e[B'|$'\eOB'|j|J) if (( sel < n )); then sel=$(( sel + 1 )); fi ;;
                q|Q|$'\x03')
                    printf '\033[?25h\033[H\033[2J'
                    echo "City pick cancelled"
                    return 1 ;;
                # / — search for any city (Nominatim); empty query —
                # go back to the file list (assets/cities.txt)
                /)
                    printf '\033[?25h'
                    printf '  Any city in the world (or coordinates 55.75,37.61). Query: '
                    local qq=""
                    local -a found=()
                    IFS= read -r qq || qq=""
                    printf '\033[?25l'
                    qq="$(printf '%s' "$qq" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
                    if [[ -z "$qq" ]]; then
                        if [[ -f "$file" ]]; then
                            mapfile -t cities < <(grep -vE '^[[:space:]]*(#|$)' "$file" | LC_ALL=C sort)
                            n=${#cities[@]}
                            sel=1
                            for ((i = 1; i <= n; i++)); do
                                if [[ "${cities[i-1]%%|*}" == "$cur" ]]; then sel=$i; break; fi
                            done
                            notice="Back to the file list"
                        fi
                    else
                        mapfile -t found < <(city_geocode "$qq")
                        if (( ${#found[@]} > 0 )); then
                            cities=("${found[@]}")
                            n=${#cities[@]}
                            sel=1
                            notice="Found for “$qq”: $n"
                        else
                            notice="Nothing found for “$qq”"
                        fi
                    fi ;;
                "") pick="${cities[sel-1]}"; break ;;
            esac
        done
        printf '\033[?25h\033[H\033[2J'
    else
        # --- non-TTY: numbered list; text instead of a number — a search ---
        local input=""
        while true; do
            echo "Cities (enter a number; type any text to search the world):"
            for ((i = 1; i <= n; i++)); do
                printf '%3d) %s\n' "$i" "${cities[i-1]%%|*}"
            done
            printf 'Number or query [Enter = %s]: ' "$cur"
            input=""
            if ! IFS= read -r input; then
                echo
                echo "stdin closed — skipping city choice (later: atmospheric city)"
                return 1
            fi
            input="$(printf '%s' "$input" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
            if [[ -z "$input" ]]; then
                break                       # Enter — keep the current city (cursor is on it)
            fi
            if [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 1 && input <= n )); then
                sel=$input
                break
            fi
            # not a number — search the world (or plain coordinates)
            local -a found=()
            mapfile -t found < <(city_geocode "$input")
            if (( ${#found[@]} > 0 )); then
                cities=("${found[@]}")
                n=${#cities[@]}
                sel=1
                echo "Found: $n — enter a number from the list"
            else
                echo "Nothing found for “$input” — enter a number from the list"
            fi
        done
        pick="${cities[sel-1]}"
    fi

    name="${pick%%|*}"
    rest="${pick#*|}"
    lat="${rest%%|*}"
    lon="${rest##*|}"

    # write in place without replacing the inode: cat > file (truncate+write
    # of the same inode), or quickshell's inotify watch won't see the save.
    local tmp="$cfg.tmp"
    while IFS= read -r line; do
        case "$line" in
            *"property string city: "*)    printf '    property string city: "%s"\n' "$name" ;;
            *"property real latitude: "*)  printf '    property real latitude: %s\n' "$lat" ;;
            *"property real longitude: "*) printf '    property real longitude: %s\n' "$lon" ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$cfg" > "$tmp"
    cat "$tmp" > "$cfg"
    rm -f "$tmp"

    echo "✓ City: $name ($lat, $lon)"
    if is_running; then
        # config hot-reload is fast, but IPC may still be starting up
        local out="" t
        sleep 0.8
        for ((t = 0; t < 15; t++)); do
            out="$(ipc_ok status 2>&1 || true)"
            [[ -n $out && $out != *"Not ready"* ]] && break
            sleep 0.4
        done
        ipc_ok refresh >/dev/null 2>&1 || true
        sleep 1.2                                # let the new city's data arrive
        ipc_ok status || true
    fi
}

# Sourced by tests: define functions, skip command dispatch.
if [[ "${BASH_SOURCE[0]:-}" != "$0" ]]; then
    return 0
fi

# --- command dispatch -------------------------------------------
cmd="${1:-start}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
    -h|--help|help)
        usage
        ;;

    -V|--version|version)
        echo "atmospheric $VERSION"
        echo "dir: $DIR"
        echo "quickshell: $(quickshell --version 2>/dev/null | head -1 || echo 'not found')"
        ;;

    install)
        do_install "$@"
        ;;

    uninstall)
        do_uninstall "$@"
        ;;

    city)
        do_city "$@"
        ;;

    autostart)
        do_autostart "${1:-status}"
        ;;

    start|run)
        if is_running; then
            ipc_ok enable >/dev/null 2>&1 || true
            echo "✓ Already running — overlay enabled"
            ipc_ok status || true
        else
            start_bg ""
        fi
        ;;

    rain|heavy-rain|drizzle|snow|fog|fog-dense|blizzard|sleet|hail|thunder|rainbow|cloudy|night|clear)
        if is_running; then
            if out=$(ipc_ok test "$cmd" 2>&1); then
                echo "✓ $out"
            else
                echo "$out" >&2
                exit 1
            fi
            ipc_ok enable >/dev/null 2>&1 || true
        else
            start_bg "$cmd"
        fi
        ;;

    auto|off-test)
        if is_running; then
            ipc_ok test off || true
            echo "✓ Real weather"
        else
            start_bg ""
        fi
        ;;

    shot|screenshot)
        do_shot "$@"
        ;;

    toggle)
        is_running || start_bg ""
        ipc_ok toggle
        ;;

    on|enable)
        is_running || start_bg ""
        ipc_ok enable
        echo "✓ Overlay enabled"
        ;;

    off|disable)
        if is_running; then
            ipc_ok disable
            echo "✓ Overlay disabled"
        else
            echo "Not running — nothing to disable"
        fi
        ;;

    status)
        echo "Session: $(env_summary)"
        echo "Autostart: $(autostart_target)"
        echo
        if is_running; then
            echo "Running."
            ipc_ok status || true
            echo
            echo "Test mode: $(ipc_ok testMode || echo '?')"
        else
            echo "Not running. Start: atmospheric"
        fi
        ;;

    stop)
        if stop_instance; then
            echo "✓ Stopped"
        else
            echo "Not running"
            stop_radar_daemons   # orphans can exist even without a running shell
        fi
        ;;

    restart)
        stop_instance || true
        start_bg ""
        ;;

    *)
        echo "atmospheric: unknown command: $cmd (see atmospheric --help)" >&2
        exit 2
        ;;
esac
